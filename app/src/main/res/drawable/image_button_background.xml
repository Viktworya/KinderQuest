<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed State (light blue border) -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <!-- White background -->
            <solid android:color="#FFFFFF"/>
            <corners android:radius="12dp"/>
            <!-- Light blue border -->

            <stroke
                android:width="3dp"
                android:color="#81D4FA"/> <!-- Light blue 400 -->

            <!-- Padding to ensure border visibility -->
            <padding
                android:bottom="2dp"
                android:left="2dp"
                android:right="2dp"
                android:top="2dp"/>
        </shape>
    </item>

    <!-- Default State -->
    <item>
        <shape android:shape="rectangle">
            <!-- White background -->
            <solid android:color="#81D4FA"/>
            <corners android:radius="12dp"/>
            <!-- Light gray border -->
            <stroke
                android:width="2dp"
                android:color="#E0E0E0"/>
        </shape>
    </item>
</selector>