                    android:scaleType="centerInside"
                    android:layout_marginStart="8dp"
                    android:contentDescription="Letter V"/>
            </LinearLayout>

            <!-- Row 12: W-X -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
