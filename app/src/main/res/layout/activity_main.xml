<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Cloud Background Image -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/cloudbg"
        android:scaleType="centerCrop"
        android:contentDescription="Cloud background"/>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <!-- App Title with Fun Emoji -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KinderQuest ✨"
                android:textSize="32sp"
                android:textColor="#FF6D00"
                android:fontFamily="casual"
                android:textStyle="bold"
                android:shadowColor="#FFFFFF"
                android:shadowRadius="4"
                android:shadowDx="2"
                android:shadowDy="2"
                android:layout_marginBottom="32dp"/>

            <!-- ABC Module -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="28dp"
                android:gravity="center">

                <androidx.cardview.widget.CardView
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="8dp"
                    app:cardBackgroundColor="#FFFFFF"
                    android:layout_gravity="center">

                    <ImageButton
                        android:id="@+id/btnAlphabet"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/abcmodule"
                        android:scaleType="centerCrop"
                        android:background="@drawable/button_ripple_kids"
                        android:contentDescription="ABC Fun"/>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ABC Fun"
                    android:textSize="20sp"
                    android:fontFamily="casual"
                    android:textColor="#3F51B5"
                    android:textStyle="bold"
                    android:background="@drawable/label_bg"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="4dp"
                    android:layout_marginTop="12dp"/>
            </LinearLayout>

            <!-- Numbers Module -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="28dp"
                android:gravity="center">

                <androidx.cardview.widget.CardView
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="8dp"
                    app:cardBackgroundColor="#FFFFFF"
                    android:layout_gravity="center">

                    <ImageButton
                        android:id="@+id/btnNumbers"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/numbermodule"
                        android:scaleType="centerCrop"
                        android:background="@drawable/button_ripple_kids"
                        android:contentDescription="123 Count"/>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="123 Count"
                    android:textSize="20sp"
                    android:fontFamily="casual"
                    android:textColor="#E91E63"
                    android:textStyle="bold"
                    android:background="@drawable/label_bg"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="4dp"
                    android:layout_marginTop="12dp"/>
            </LinearLayout>

            <!-- Colors & Shapes Module -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <androidx.cardview.widget.CardView
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="8dp"
                    app:cardBackgroundColor="#FFFFFF"
                    android:layout_gravity="center">

                    <ImageButton
                        android:id="@+id/btnColorsShapes"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/colorshapesmodule"
                        android:scaleType="centerCrop"
                        android:background="@drawable/button_ripple_kids"
                        android:contentDescription="Colors and Shapes"/>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Colors and Shapes"
                    android:textSize="20sp"
                    android:fontFamily="casual"
                    android:textColor="#009688"
                    android:textStyle="bold"
                    android:background="@drawable/label_bg"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="4dp"
                    android:layout_marginTop="12dp"/>
            </LinearLayout>

            <!-- Add extra space at the bottom for better scrolling -->
            <View
                android:layout_width="match_parent"
                android:layout_height="24dp"/>
        </LinearLayout>
    </ScrollView>
</FrameLayout>